{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "CI builds metadata ID tokens",
  "type": "object",
  "patternProperties": {
    ".*": {
      "type": "object",
      "required": [
        "aud"
      ],
      "properties": {
        "aud": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        },
        "target_audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "additionalProperties": false
    }
  }
}
